# Base URL of the Phase 1-3 FastAPI backend.
NEXT_PUBLIC_API_BASE_URL=http://localhost:8000

# Optional: override the map's keyless OpenStreetMap basemap with your own
# tile server. Leave unset to use OSM's standard tiles (no account or key).
# NEXT_PUBLIC_BASEMAP_TILE_URL=https://your-tiles/{z}/{x}/{y}.png
